# Copy this file to .env and fill in real values. .env is gitignored.

# SECRET_KEY=your-secret-key
# DEBUG=True

# --- Database (MySQL) ---
# Falls back to sqlite if unset (see config/settings.py). Format:
# mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=mysql://hms_user:your-password@localhost:3306/hms

# --- Email (login OTP verification) ---
# For real Gmail sending, use an App Password (not your normal Gmail password):
# https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
